# Postgres connection string (Neon, Supabase, local Postgres, etc.)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Set to the public URL of the app in production
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Optional. Leave both blank to use email/password sign-in only.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Web push notifications. Generate a pair with: npm run push:keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is inlined at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://your-domain.com"
